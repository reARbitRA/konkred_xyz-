{
  "name": "konkred-–-production-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx start.ts",
    "build:client": "npm run validate:portfolio && vite build",
    "bundle:api": "esbuild server.ts --bundle --platform=node --format=cjs --minify --legal-comments=none --supported:template-literal=false --outfile=lib/fullkonk-server.cjs",
    "build:vercel": "npm run build:client && npm run bundle:api",
    "build": "npm run build:client && esbuild start.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:portfolio": "tsx scripts/validate-portfolio.mjs"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@google/genai": "^1.34.0",
    "cors": "^2.8.6",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "firebase": "^12.8.0",
    "firebase-admin": "^14.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.40.0",
    "pg": "^8.21.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
