# Server-side secrets (Never exposed to client)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
GITHUB_TOKEN=
QWEN_ACCESS_KEY_ID=
QWEN_ACCESS_KEY_SECRET=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=

# App Configuration
VITE_APP_NAME=KONKRED
VITE_API_URL=http://localhost:3000

# GitHub OAuth integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Crypto Addresses
VITE_TRUST_WALLET_USDT_TRON=


# ---------------------------------------------------------------------------
# Konkred AI Ecosystem Gateway (server-side only — never prefix with VITE_)
# Full guide: docs/fullkonk/GATEWAY_INTEGRATION.md
# ---------------------------------------------------------------------------
# Gateway origin, deployed separately from this repository (no trailing slash).
# Legacy aliases still honoured: GATEWAY_URL, BRAIN_URL.
KONKRED_GATEWAY_URL=
# Caller key for the gateway's POST /api/ai (legacy aliases: GATEWAY_API_KEY, BRAIN_API_KEY).
KONKRED_GATEWAY_API_KEY=
# Shared brain secret sent as x-brain-key; must match FULLKONK_KEY on the gateway.
FULLKONK_KEY=
# Optional server-owned GitHub token for /api/fullkonk/github/export. When set,
# tokens typed into the UI are ignored. GITHUB_TOKEN above is deliberately NOT used here.
FULLKONK_GITHUB_EXPORT_TOKEN=
# Optional: require a verified Firebase ID token on gateway routes (default false).
FULLKONK_REQUIRE_AUTH=false
# Optional: Firebase admin credentials used by FULLKONK_REQUIRE_AUTH and session routes.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: extra browser origins allowed to call the BFF (comma separated).
FULLKONK_ALLOWED_ORIGINS=
# Optional: 1 = allow the in-repo engine to serve gateway routes when no gateway is
# configured (default true outside production, false in production).
FULLKONK_LEGACY_ENGINE_FALLBACK=
