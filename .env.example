# Supabase: public browser configuration (RLS protects all user data).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server auth uses the same public configuration; no service-role key needed.
# See docs/SUPABASE_MIGRATION.md for setup and remaining deployment steps.

# ─────────────────────────────────────────────────────────────────────────────
# KONKRED — CENTRAL API GATEWAY (embedded, server-side only)
#
# The gateway is now EMBEDDED in this repository (gateway/src/*, copied from
# reARbitRA/konkred-AI-ecosystem). Vercel function api/index.ts exposes the
# OpenAI-compatible API at /v1/* via the same deployment that serves the
# website (/* → index.html preserved). api.konkred.xyz will point here after
# preview health/auth passes — do NOT move DNS until then.
#
# Security invariants (must not be broken):
# • Provider credentials are SERVER-ONLY (no VITE_ prefix, never in bundle).
#   They keep provider names (GEMINI_KEY_P1, AGNES_API_KEY, APMIX_API_KEY,
#   DEEPSEEK_API_KEY, HUGGINGFACE_API_KEY, OPENAI_API_KEY, etc.) — never KRED_*.
#   A key alone does NOT imply a non-OpenAI protocol; generic providers need
#   *_BASE_URL (or *_ENDPOINT) and *_MODEL(S) to be discovered.
# • Gateway client keys are kred_ (kred_live_<random>) per app, admin is
#   kred_admin_<random> for /api/status and cache flush. They are validated
#   against USERS_JSON / USERS_JSON_BASE64 (registry below). Provider secrets
#   and gateway keys are different namespaces.
# • Browser never sees either class of secret — same-origin /api/* only.
#
# ── Gateway identity (kred_ keys) ───────────────────────────────────────────
# Generate per-app keys with: openssl rand -hex 24 | sed 's/^/kred_live_/';
# Admin: openssl rand -hex 32 | sed 's/^/kred_admin_/';
# Then add to USERS_JSON_BASE64 (preferred for Vercel env limits) as:
#   [{"key":"kred_live_<app1>","userId":"<appId>","tier":"standard"}, ...]
# tier ∈ internal | trusted | standard | free (see gateway/src/config.mjs
# TIER_LIMITS). Ask for appIds/tiers instead of guessing — do not invent.
ADMIN_KEY=
# Preferred: base64-encoded JSON array (platforms that cannot preserve raw JSON).
# Example shell: echo -n '[{"key":"kred_live_...","userId":"my-app","tier":"standard"}]' | base64 -w0
USERS_JSON_BASE64=
# Fallback: inline JSON array. USERS_JSON wins when both are set.
USERS_JSON=
# Set true only for local experiments — allows keyless calls as tier "free".
ALLOW_ANONYMOUS=false
ANONYMOUS_TIER=free

# ── Provider credentials (server-only, Vercel Production/Preview/Development) ─
# At least ONE provider key is required unless DEMO_MOCK=true (offline smoke).
# Known profiles (see gateway/src/providers/profiles.mjs + gateway/src/config.mjs):
#   APMIX (APMIX_API_KEY, APMIX_MODEL/APMIX_MODELS, APMIX_BASE_URL=https://api.apmix.ai/v1)
#   Agnes AI (AGNES_API_KEY, AGNES_MODEL=agnes-2.5-flash, AGNES_BASE_URL=https://apihub.agnes-ai.com/v1)
#   DeepSeek (DEEPSEEK_API_KEY, DEEPSEEK_MODEL=deepseek-chat, DEEPSEEK_BASE_URL=https://api.deepseek.com/v1)
#   Hugging Face (HUGGINGFACE_API_KEY or HF_TOKEN, HUGGINGFACE_MODEL=Qwen/Qwen3-32B)
#   OpenAI (OPENAI_API_KEY, OPENAI_MODEL=gpt-4o-mini)
# Generic OpenAI-compatible providers are auto-discovered when all three are set:
#   <PREFIX>_API_KEY, <PREFIX>_BASE_URL (or <PREFIX>_ENDPOINT for full /chat/completions URL),
#   and <PREFIX>_MODEL or <PREFIX>_MODELS. Key alone never enables a provider.
APMIX_API_KEY=
APMIX_MODEL=deepseek-v4.1-flash-free
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3-32B
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Generic example: MYAI_API_KEY=..., MYAI_BASE_URL=https://api.example.com/v1, MYAI_MODEL=...

# Legacy Gemini / other provider keys (still supported via gateway config detection)
GEMINI_API_KEY=
GEMINI_KEY_P1=
GEMINI_KEY_P2=
GEMINI_KEY_P3=
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GITHUB_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Gateway behaviour (sane defaults in gateway/src/config.mjs) ──────────────
DEMO_MOCK=false
MOCK_FALLBACK=true
MAX_ATTEMPTS=6
ATTEMPT_TIMEOUT_MS=90000
CONNECT_TIMEOUT_MS=10000
DEFAULT_MAX_TOKENS=2048
HARD_MAX_TOKENS=8192
CACHE_ENABLED=true
CACHE_TTL_MS=900000
DEDUP_ENABLED=true
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MS=60000
DASHBOARD_ENABLED=false
CORS_ALLOW_ORIGINS=https://konkred.xyz,https://www.konkred.xyz
CORS_ALLOW_ALL=false
# On Vercel serverless, set: WATCHDOG_ENABLED=false, MAX_ATTEMPTS=2,
# ATTEMPT_TIMEOUT_MS=40000 to fit within maxDuration 300.
# Legacy BFF proxy (optional fallback while KONKRED_GATEWAY_URL is set):
# When set, /api/fullkonk/* and /api/ai are proxied to that URL instead of
# the embedded gateway. Leave EMPTY to use the embedded gateway.
KONKRED_GATEWAY_URL=
KONKRED_GATEWAY_API_KEY=
FULLKONK_KEY=
# Legacy direct provider keys for standalone server.ts /api/ai/generate (not gateway)
# These are kept for local dev compatibility; gateway uses the provider keys above.
ANTHROPIC_API_KEY=
XAI_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
QWEN_ACCESS_KEY_ID=
QWEN_ACCESS_KEY_SECRET=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=

# App Configuration (VITE_ values ARE bundled into the browser — never secrets)
VITE_APP_NAME=KONKRED
VITE_API_URL=http://localhost:3000

# GitHub OAuth integration (server-side)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Crypto Addresses (safe to expose)
VITE_TRUST_WALLET_USDT_TRON=


# ---------------------------------------------------------------------------
# Konkred AI Ecosystem Gateway (server-side only — never prefix with VITE_)
# Full guide: docs/fullkonk/GATEWAY_INTEGRATION.md
# ---------------------------------------------------------------------------
# Gateway origin, deployed separately from this repository (no trailing slash).
# Legacy aliases still honoured: GATEWAY_URL, BRAIN_URL.
# Caller key for the gateway's POST /api/ai (legacy aliases: GATEWAY_API_KEY, BRAIN_API_KEY).
# Shared brain secret sent as x-brain-key; must match FULLKONK_KEY on the gateway.
# Optional server-owned GitHub token for /api/fullkonk/github/export. When set,
# tokens typed into the UI are ignored. GITHUB_TOKEN above is deliberately NOT used here.
FULLKONK_GITHUB_EXPORT_TOKEN=
# Optional: require a verified Supabase ID token on gateway routes (default false).
FULLKONK_REQUIRE_AUTH=false
# Optional: Supabase admin credentials used by FULLKONK_REQUIRE_AUTH and session routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: extra browser origins allowed to call the BFF (comma separated).
FULLKONK_ALLOWED_ORIGINS=
# Optional: 1 = allow the in-repo engine to serve gateway routes when no gateway is
# configured (default true outside production, false in production).
FULLKONK_LEGACY_ENGINE_FALLBACK=
# ─────────────────────────────────────────────────────────────────────────────
# Quota ledger and workflow execution (server-side only)
#
# DATABASE_URL   PostgreSQL connection string. Without it the app still serves
#                and /api/workflows/:slug/run still executes, but UNMETERED
#                (credits.metered:false in the response) — matching the existing
#                behaviour of server/gateway-proxy.ts. Public demos, by
#                contrast, fail CLOSED without it: their abuse ceiling is
#                counted in SQL and cannot be enforced from process memory on
#                serverless instances that share nothing.
# ANON_SALT      Salt for hashing anonymous identities and demo client IPs.
#                Rotating it resets anonymous quotas and demo counters.
# INTERNAL_API_KEY  Shared secret for /api/internal/* quota administration.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=
ANON_SALT=
INTERNAL_API_KEY=

# Public demo abuse limits (optional; defaults shown).
# WORKFLOW_DEMO_IP_HOURLY_MAX  demo runs per client IP per rolling 60 minutes
# WORKFLOW_DEMO_DAILY_MAX      demo runs across ALL callers per rolling 24 h.
#   The global ceiling is the one that caps spend: the per-IP limit alone is
#   defeated by a botnet. Both are counted in SQL, before the gateway call, so
#   a failing run still consumes the allowance.
WORKFLOW_DEMO_IP_HOURLY_MAX=5
WORKFLOW_DEMO_DAILY_MAX=200

# NowPayments (server-side only; the payment path is already shipped)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
