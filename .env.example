# ─────────────────────────────────────────────────────────────────────────────
# KONKRED — KONKRED AI ECOSYSTEM GATEWAY INTEGRATION (Vercel, server-side only)
#
# These variables are read ONLY by the Vercel Node.js serverless function
# (api/index.ts → server/gateway-proxy.ts). They are never prefixed with
# VITE_/NEXT_PUBLIC, never bundled into the browser, and never returned in a
# response or written to a log. The browser only calls same-origin /api/* routes.
#
# KONKRED_GATEWAY_URL      Root URL of the separately deployed Konkred Gateway.
#                          Must be https in production (never localhost).
# KONKRED_GATEWAY_API_KEY  Sent as x-api-key to POST /api/ai (standard inference).
# FULLKONK_KEY             Sent as x-brain-key to /api/fullkonk/* (providers,
#                          SSE generation, GitHub export).
#
# Legacy aliases BRAIN_URL / BRAIN_KEY (from the earlier proxy) are still
# accepted as fallbacks; the explicit KONKRED_* / FULLKONK_KEY names win.
# Leave values EMPTY here — real values live in the Vercel project settings
# (Production and Preview environments), never in git.
# ─────────────────────────────────────────────────────────────────────────────
KONKRED_GATEWAY_URL=
KONKRED_GATEWAY_API_KEY=
FULLKONK_KEY=
# Legacy aliases (optional):
# BRAIN_URL=
# BRAIN_KEY=

# Server-side provider keys — used ONLY by the standalone/local Express server
# (npm run dev) and legacy server routes. Not required on Vercel when the
# gateway is configured; never exposed to the client.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
GITHUB_TOKEN=
QWEN_ACCESS_KEY_ID=
QWEN_ACCESS_KEY_SECRET=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=

# App Configuration (VITE_ values ARE bundled into the browser — never secrets)
VITE_APP_NAME=KONKRED
VITE_API_URL=http://localhost:3000

# GitHub OAuth integration (server-side)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Crypto Addresses (safe to expose)
VITE_TRUST_WALLET_USDT_TRON=
